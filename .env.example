# ---- PostgreSQL (used by docker-compose and Django) ----
POSTGRES_DB=dairydesk
POSTGRES_USER=dairydesk
POSTGRES_PASSWORD=dairydesk
POSTGRES_PORT=5432

# ---- Django ----
# Host/port Django uses to reach Postgres. When Django runs on the host
# (not in a container), DB host is localhost and port matches POSTGRES_PORT above.
DB_HOST=localhost
DB_PORT=5432

# Generate a real one for anything beyond local dev:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
