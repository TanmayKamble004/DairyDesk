# Copy to .env only if you want to override something — docker compose has a
# working default for every value below, so a fresh clone needs no .env at all.

# ---- PostgreSQL (used by docker-compose and Django) ----
POSTGRES_DB=dairydesk
POSTGRES_USER=dairydesk
POSTGRES_PASSWORD=dairydesk
# Host port Postgres is published on (for pgAdmin/DBeaver, or host-run Django).
# Change this if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# ---- Django ----
# Only used when Django runs on the HOST (the "without Docker" path).
# The backend container ignores these: compose always sets DB_HOST=db and
# DB_PORT=5432, because inside the compose network it talks to the service
# name and the container's own port.
DB_HOST=localhost
DB_PORT=5432

# Generate a real one for anything beyond local dev:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Docker dev stack ----
# Host ports the containers publish. Change if these clash with something.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# If you change FRONTEND_PORT, also set this to the same value so HMR can
# reconnect through the remapped port.
# VITE_HMR_CLIENT_PORT=5173

# Where the browser reaches the API (the published backend port).
VITE_API_URL=http://localhost:8000

# Set to false to stop the backend container seeding demo data into an empty DB.
SEED_DEMO=true
