# Copy to .env only if you want to override something — docker compose has a
# working default for every value below, so a fresh clone needs no .env at all.

# ---- PostgreSQL (used by docker-compose and Django) ----
POSTGRES_DB=dairydesk
POSTGRES_USER=dairydesk
POSTGRES_PASSWORD=dairydesk
# Host port Postgres is published on (for pgAdmin/DBeaver, or host-run Django).
# Change this if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# ---- Django ----
# Only used when Django runs on the HOST (the "without Docker" path).
# The backend container ignores these: compose always sets DB_HOST=db and
# DB_PORT=5432, because inside the compose network it talks to the service
# name and the container's own port.
DB_HOST=localhost
DB_PORT=5432

# Generate a real one for anything beyond local dev:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Docker dev stack ----
# Host ports the containers publish. Change if these clash with something.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# If you change FRONTEND_PORT, also set this to the same value so HMR can
# reconnect through the remapped port.
# VITE_HMR_CLIENT_PORT=5173

# Where the browser reaches the API (the published backend port).
VITE_API_URL=http://localhost:8000

# Set to false to stop the backend container seeding demo data into an empty DB.
SEED_DEMO=true

# ---- Timezone ----
# Sets every container's clock and Django's TIME_ZONE from one place, so logs,
# the admin and the app all agree. Storage is unaffected — Postgres keeps
# timestamps in UTC either way — but this is what "today" means for expiry
# dates, so it should be the shop's own timezone.
TZ=Asia/Kolkata

# ---- RabbitMQ ----
# Carries LOW_STOCK events from the main app to the notification service.
RABBITMQ_USER=dairydesk
RABBITMQ_PASSWORD=dairydesk
RABBITMQ_PORT=5672
# Management UI: http://localhost:15672 — log in with the two values above to
# watch messages move through notifications.low_stock.
RABBITMQ_UI_PORT=15672

# How often the relay sweeps the outbox for events to publish, in seconds.
OUTBOX_POLL_SECONDS=5

# Set to true to alert suppliers only for products with auto-reorder switched
# on. Default false: raising a purchase order is a financial commitment and
# rightly opt-in, but telling a supplier you are running low is not.
NOTIFY_ONLY_AUTO_REORDER=false

# ---- Notification service: email ----
# "console" prints the alert to the container log and needs no credentials —
# the whole pipeline works on a fresh clone. Switch to "smtp" to really send.
EMAIL_BACKEND=console

# Gmail. EMAIL_HOST_PASSWORD must be a 16-character Google *App Password*, not
# the account password — generate one at myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account). Spaces may be stripped.
#
# Never commit real values. .env is gitignored; this file is not.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=DairyDesk Inventory <your-address@gmail.com>

# Send every alert here instead of to the supplier on the event. The seeded demo
# suppliers have invented addresses, so set this to your own inbox before
# demoing against seed data.
# REDIRECT_ALL_EMAIL_TO=you@example.com

# Hours of silence per product after a successful alert. The backstop against
# spamming a supplier whose stock keeps crossing the threshold.
COOLDOWN_HOURS=24

# ---- Email (SMTP) ----
# Leave EMAIL_HOST_USER blank and Django prints mail to the console instead of
# sending it — no mailbox needed for local dev.
#
# For Gmail: the account needs 2-Step Verification on, then create an App
# Password (Google Account > Security > App passwords). Use that 16-character
# value below with the spaces removed — a normal account password won't work.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Defaults to "DairyDesk <EMAIL_HOST_USER>". Gmail rewrites any From address
# that isn't the authenticated account, so only change the display name.
# DEFAULT_FROM_EMAIL=DairyDesk <you@gmail.com>
